{
  "name": "hyper-motion-electron",
  "private": true,
  "version": "0.1.11",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "description": "Native motion design tool with Figma-style structural layout. Auto-layout, 3D camera, semantic keyframes, pixel-correct MP4 / WebM / GIF.",
  "license": "Apache-2.0",
  "author": "Siddharth Ponnapalli",
  "homepage": "https://hypermotion.app",
  "scripts": {
    "dev": "vite",
    "build": "vite build && electron-builder --publish=never",
    "build:dir": "vite build && electron-builder --dir",
    "build:mac": "vite build && electron-builder --mac --publish=never",
    "build:win": "vite build && electron-builder --win --publish=never",
    "lint": "eslint .",
    "test": "pnpm --dir cli test",
    "test:canvas": "vitest run src/render/strokePattern.test.ts src/render3d/texturePolicy.test.ts src/render3d/scene3d.hitTest.test.ts src/render3d/textAnimationLayout.test.ts src/anim/engine.test.ts src/anim/multiKeyframes.test.ts src/anim/staggerSets.test.ts src/state/groupActions.test.ts src/state/staggerSelection.test.ts src/ui/hooks/useAnimatedValues.test.ts src/ui/cameraPreviewStore.test.ts src/ui/cameraWheel.test.ts src/ui/cameraReset.test.ts src/ui/canvasTextEditing.test.ts src/ui/keyframeDragPreviewStore.test.ts src/ui/multiRenderMode.test.ts src/ui/sectionDragPreviewStore.test.ts src/ui/timelineDragHitArea.test.ts src/ui/textAnimationSegments.test.ts",
    "test:figma": "vitest run src/import/figma src/ui/fonts/googleFonts.test.ts",
    "typecheck": "tsc -b",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.10",
    "@ffmpeg/util": "^0.12.1",
    "gifenc": "^1.0.3",
    "immer": "^11.1.4",
    "mp4-muxer": "^5.2.2",
    "pixi.js": "^8.6.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "three": "^0.184.0",
    "y-indexeddb": "^9.0.12",
    "yjs": "^13.6.30",
    "yoga-layout": "^3.2.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "tailwindcss": "^4.2.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.9",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.hypermotion.app",
    "productName": "hyper-motion",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "darkModeSupport": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
